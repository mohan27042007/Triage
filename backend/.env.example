# Create a local .env file from this template and add your own key.
OPENAI_API_KEY=your_openai_api_key_here
DEMO_PASSWORD=choose_a_single_shared_demo_password
# Comma-separated browser origins. Add the deployed Vercel URL in Railway.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional durable archive storage for hosted deployments (S3-compatible/R2).
# Leave ARCHIVE_STORAGE_BACKEND unset for the local backend/archive fallback.
# ARCHIVE_STORAGE_BACKEND=s3
# S3_BUCKET=triage-attachments
# S3_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=...
# S3_SECRET_ACCESS_KEY=...
# S3_PREFIX=triage

# Optional durable Web Push deadline reminders (hosted auth + Postgres only).
# Keep the private key and dispatch secret only in Railway, never in frontend code.
# VAPID_PUBLIC_KEY=...
# VAPID_PRIVATE_KEY=...
# VAPID_SUBJECT=mailto:you@example.com
# REMINDER_DISPATCH_SECRET=generate_a_long_random_value
# REMINDER_TIMEZONE=Asia/Kolkata
